{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_perf_perf-engine__approve_.*|Bash|Read|Grep|Glob|Edit|Write",
        "hooks": [
          { "type": "command", "command": "uv", "args": ["run", "--no-project", "--quiet", "--managed-python", "--python", ">=3.12", "python", "${CLAUDE_PLUGIN_ROOT}/hooks/guard.py", "pretool"], "timeout": 20 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "uv", "args": ["run", "--no-project", "--quiet", "--managed-python", "--python", ">=3.12", "python", "${CLAUDE_PLUGIN_ROOT}/hooks/guard.py", "prompt"], "timeout": 20 }
        ]
      }
    ]
  }
}
