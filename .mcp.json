{
  "mcpServers": {
    "perf-engine": {
      "command": "uv",
      "args": ["run", "--quiet", "--frozen", "--project", "${CLAUDE_PLUGIN_ROOT}", "perfeng-mcp"],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv",
        "PERF_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}"
      }
    }
  }
}
