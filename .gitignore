# Python / uv
.venv/
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/

# Secrets (never commit; .env.example is the template)
.env
.env.*
!.env.example

# perf project state generated by the engine
.perf/state/
.perf/artifacts/

# Generated by tests and evals (regenerable)
evals/reports/
plugin-evals/results/
sut/.cache/

# Node
node_modules/

# Local Claude Code settings
.claude/settings.local.json

# Accidental artifact: a process run without %SystemDrive% set writes Windows cache files to a literal
# "%SystemDrive%" folder in the current directory. Never needed.
%SystemDrive%/
